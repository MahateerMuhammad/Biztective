# Backend configuration. Copy to services/api/.env (git-ignored). All values are required unless noted.
ENVIRONMENT=local
# Runtime role (least privilege, RLS applies). Use ROOT_APP_DB_PASSWORD from the root .env.
DATABASE_URL=postgresql+psycopg://root_app:CHANGE_ME@127.0.0.1:5432/root
# Schema-owner role: migrations and admin CLI only, never the web process.
DATABASE_URL_MIGRATIONS=postgresql+psycopg://root_owner:CHANGE_ME@127.0.0.1:5432/root
# At least 32 characters of randomness.
SESSION_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
# Optional: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional LLM (AMD-12, AMD-16): disabled (default, deterministic investigations) | anthropic | groq
LLM_PROVIDER=disabled
# Required when LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
# Optional overrides: LLM_MODEL (default claude-opus-5-5), LLM_EFFORT (low|medium|high),
# LLM_TIMEOUT_SECONDS, LLM_MAX_RETRIES, LLM_MAX_CALLS, LLM_MAX_TOKENS, LLM_DEADLINE_SECONDS
# Required when LLM_PROVIDER=groq. Never commit a real key.
GROQ_API_KEY=
# Optional: GROQ_MODEL (default openai/gpt-oss-120b)
# Whole investigation run (checkpoint lock, tools, graph), default 600 seconds:
# INVESTIGATION_TIMEOUT_SECONDS=600
# Tracing must stay off: do not set LANGSMITH_TRACING / LANGCHAIN_TRACING_V2.

# Demo account seed (python -m app.cli seed-demo). Password: 12-128 characters.
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_OWNER_NAME=Demo Owner
DEMO_BUSINESS_NAME=
DEMO_BUSINESS_CURRENCY=USD
DEMO_BUSINESS_TIMEZONE=UTC

# Test suite: owner/superuser URL of a server where disposable databases can be created.
TEST_DATABASE_ADMIN_URL=postgresql+psycopg://root_owner:CHANGE_ME@127.0.0.1:5432/postgres
TEST_APP_DB_PASSWORD=

# Optional Google Sheets execution (AMD-18). Base64 of a service-account key file, e.g.
# GOOGLE_SERVICE_ACCOUNT_JSON="$(base64 < key.json)". Backend only; never commit a real key.
# Without it, spreadsheets cannot be connected and approved plans cannot be executed.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or (AMD-19) an Apps Script web app deployed from integrations/apps_script/Code.gs inside the
# spreadsheet; both values together. The token is a secret of at least 32 characters.
SHEETS_BRIDGE_URL=
SHEETS_BRIDGE_TOKEN=
# Optional: SHEETS_TIMEOUT_SECONDS (45), SHEETS_MAX_RETRIES (4), SHEETS_BACKOFF_SECONDS (1.0)
