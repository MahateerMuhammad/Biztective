# Docker Compose (local PostgreSQL). Copy to .env and set strong random values, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
ROOT_APP_DB_PASSWORD=
POSTGRES_PORT=5432

# Production container deployment (see services/api/.env.example and apps/web/.env.example).
# Least-privilege runtime role (root_app, RLS enforced) vs schema-owner role (root_owner, migrations/seed only):
# DATABASE_URL=postgresql+psycopg://root_app:CHANGE_ME@db.example.internal:5432/root
# DATABASE_URL_MIGRATIONS=postgresql+psycopg://root_owner:CHANGE_ME@db.example.internal:5432/root
# PORT=8000
# RUN_MIGRATIONS=1
# SEED_DEMO_ON_START=0
