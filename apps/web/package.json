{
  "name": "root-web",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
